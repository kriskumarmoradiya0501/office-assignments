@model List<Repositories.t_Contact>

@{
    ViewData["Title"] = "My Contacts";
}

<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Contacts</h2>

        <a asp-controller="Contact"
           asp-action="Create"
           class="btn btn-success">
            + Add Contact
        </a>
    </div>


    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">
            @TempData["Message"]
        </div>
    }


    @if (Model.Count == 0)
    {
        <div class="card shadow">
            <div class="card-body text-center">

                <h4>No Contacts Found</h4>

                <p class="text-muted">
                    You haven't added any contacts yet.
                </p>

                <a asp-controller="Contact"
                   asp-action="Create"
                   class="btn btn-primary">
                    Add Your First Contact
                </a>

            </div>
        </div>
    }
    else
    {
        <div class="card shadow">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-dark">

                            <tr>
                                <th>Image</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Group</th>
                                <th>Address</th>
                                <th>Mobile</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var contact in Model)
                            {
                                <tr>

                                    <!-- Image -->
                                    <td>

                                        @if (!string.IsNullOrEmpty(contact.c_image))
                                        {
                                            <img src="~/profile_images/@contact.c_image"
                                                 class="contact-image"
                                                 alt="Contact Picture" />
                                        }
                                        else
                                        {
                                            <div class="contact-placeholder">
                                                @contact.c_name.Substring(0, 1).ToUpper()
                                            </div>
                                        }

                                    </td>


                                    <!-- Name -->
                                    <td>
                                        <strong>
                                            @contact.c_name
                                        </strong>
                                    </td>


                                    <!-- Email -->
                                    <td>
                                        @contact.c_email
                                    </td>


                                    <!-- Group -->
                                    <td>
                                        @contact.c_group
                                    </td>


                                    <!-- Address -->
                                    <td>
                                        @contact.c_address
                                    </td>


                                    <!-- Mobile -->
                                    <td>
                                        @contact.c_mobile
                                    </td>


                                    <!-- Status -->
                                    <td>

                                        @if (contact.c_status)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactive
                                            </span>
                                        }

                                    </td>


                                    <!-- Actions -->
                                    <td>

                                        <a asp-controller="Contact"
                                           asp-action="Edit"
                                           asp-route-id="@contact.c_contactid"
                                           class="btn btn-warning btn-sm">
                                            Edit
                                        </a>


                                        <form asp-controller="Contact"
                                              asp-action="Delete"
                                              asp-route-id="@contact.c_contactid"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this contact?');">

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm">
                                                Delete
                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>