@model Repositories.t_User

@{
    ViewData["Title"] = "My Profile";
}

<div class="container">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow">

                <div class="card-header bg-dark text-white">
                    <h3 class="mb-0">My Profile</h3>
                </div>

                <div class="card-body">

                    <div class="row align-items-center">

                        <!-- Profile Image -->
                        <div class="col-md-4 text-center">

                            @if (!string.IsNullOrEmpty(Model.c_image))
                            {
                                <img src="~/profile_images/@Model.c_image"
                                     class="rounded-circle profile-image"
                                     alt="Profile Picture" />
                            }
                            else
                            {
                                <div class="profile-placeholder">
                                    @Model.c_username.Substring(0, 1).ToUpper()
                                </div>
                            }

                            <h4 class="mt-3">
                                @Model.c_username
                            </h4>

                        </div>


                        <!-- User Information -->
                        <div class="col-md-8">

                            <div class="profile-info">

                                <p>
                                    <strong>Name:</strong>
                                    @Model.c_username
                                </p>

                                <p>
                                    <strong>Email:</strong>
                                    @Model.c_email
                                </p>

                                <p>
                                    <strong>Mobile:</strong>
                                    @Model.c_mobile
                                </p>

                                <p>
                                    <strong>Gender:</strong>
                                    @Model.c_gender
                                </p>

                                <p>
                                    <strong>Address:</strong>
                                    @Model.c_address
                                </p>

                            </div>

                        </div>

                    </div>

                    <hr />

                    <!-- Actions -->

                    <div class="text-center">

                        <a asp-controller="Contact"
                           asp-action="List"
                           class="btn btn-primary me-2">
                            My Contacts
                        </a>

                        <a asp-controller="Contact"
                           asp-action="Create"
                           class="btn btn-success me-2">
                            Add Contact
                        </a>

                        <a asp-controller="Contact"
                           asp-action="Logout"
                           class="btn btn-danger">
                            Logout
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>