<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Contact Management
    </title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/site.css" />

    <link rel="stylesheet" href="~/Views/Shared/_ContactLayout.cshtml.css" />

    <link rel="stylesheet" href="~/css/contact.css" />

</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">

        <div class="container">

            <a class="navbar-brand" asp-controller="Contact" asp-action="Index">
                Contact Management
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#contactNavbar">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse" id="contactNavbar">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">

                        <a class="nav-link" asp-controller="Contact" asp-action="Index">
                            Profile
                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link" asp-controller="Contact" asp-action="List">
                            My Contacts
                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link" asp-controller="Contact" asp-action="Create">
                            Add Contact
                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link" asp-controller="Contact" asp-action="Logout">
                            Logout
                        </a>

                    </li>

                </ul>

            </div>

        </div>

    </nav>


    <main class="container mt-4">

        @RenderBody()

    </main>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>