@model Crud_Ajax.Models.InternClass
@{
    ViewData["Title"] = "Add New Intern";
}
<!-- Bootstrap CSS -->
<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<!-- Bootstrap JS -->
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
<h1>Add New Intern</h1>
<div id="ajaxMessage" class="alert" hidden></div>
<form asp-action="Insert" method="post" enctype="multipart/form-data" data-ajax="true">
    <div asp-validation-summary="All" class="text-danger">
    </div>
    <div class="form-group">
        <label asp-for="InternName"></label>
        <input asp-for="InternName" class="form-control" />
        <span asp-validation-for="InternName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Gender"></label>
        <div class="col-md-10">
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="Gender" value="M" />
                <label class="form-check-label">Male</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="Gender" value="F" />
                <label class="form-check-label">Female</label>
            </div>
        </div>
        <span asp-validation-for="Gender" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="TopicId"></label>
        <select asp-for="TopicId" class="form-control">
            <option value="">Select Topic</option>
            @if (ViewBag.Topics != null)
            {
                @foreach (var topic in ViewBag.Topics)
                {
                    <option value="@topic.TopicId">@topic.TopicName</option>
                }
            }
        </select>
        <span asp-validation-for="TopicId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="DateOfPresentation"></label>
        <input asp-for="DateOfPresentation" class="form-control" type="date" />
        <span asp-validation-for="DateOfPresentation" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Status"></label>
        <input asp-for="Status" type="checkbox" />
        <span id="statusError" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="TopicImageFile"></label>
        <input asp-for="TopicImageFile" type="file" class="form-control" />
        <span asp-validation-for="TopicImageFile" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Add Intern</button>
    <a asp-action="GetAll" class="btn btn-secondary">Cancel</a>
</form>
@section Scripts {
    <script>
        $(document).ready(function () {
            $("form").submit(function (e) {
                if (!$("#Status").is(":checked")) {
                    e.preventDefault();
                    $("#statusError").text("Presentation Status must be checked.");
                }
                else {
                    $("#statusError").text("");
                }
            });
        });
    </script>
    @* @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    @{ Html.RenderPartial("_ValidationScriptsPartial");} *@
    <partial name="_ValidationScriptsPartial" />
}
