@model Crud_Ajax.Models.InternClass
@{
    ViewData["Title"] = "Delete Intern";
}
<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<!-- Bootstrap JS -->
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

<h1>Delete Intern</h1>
<div>
    <h4>Are you sure you want to delete this intern?</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Intern ID</dt>
        <dd class="col-sm-10">@Model.InternId</dd>
        <dt class="col-sm-2">Intern Name</dt>
        <dd class="col-sm-10">@Model.InternName</dd>
        <dt class="col-sm-2">Gender</dt>
        <dd class="col-sm-10">@Model.Gender</dd>
        <dt class="col-sm-2">Assigned Topic</dt>
        <dd class="col-sm-10">
            @if (Model.AssignedTopic != null)
            {
                @Model.AssignedTopic.TopicName
            }
            else
            {
                <span>N/A</span>
            }
        </dd>
        <dt class="col-sm-2">Date of Presentation</dt>
        <dd class="col-sm-10">@Model.DateOfPresentation.ToShortDateString()</dd>
        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">
            @if (Model.Status)
            {
                <span>Presented</span>
            }
            else
            {
                <span>Not Presented</span>
            }
        </dd>
    </dl>
</div>
<div id="ajaxMessage" class="alert" hidden></div>
<form asp-action="DeleteConfirmed" asp-route-id="@Model.InternId" method="post" data-ajax="true">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="GetAll" class="btn btn-secondary">Cancel</a>
</form>
